#include <winver.h>

/* Icon 1 is the app icon and the tray icon while sending; icon 2 is the idle
   tray icon. Regenerate both with tools/make_relay_icon.py. */
1 ICON "gridtalk.ico"
2 ICON "gridtalk-idle.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GRIDTALK_VERSION_MAJOR, GRIDTALK_VERSION_MINOR, GRIDTALK_VERSION_PATCH, 0
PRODUCTVERSION GRIDTALK_VERSION_MAJOR, GRIDTALK_VERSION_MINOR, GRIDTALK_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GridTalk TS6 Relay (TeamSpeak 5 and 6 only; TeamSpeak 3 uses the plugin)"
            VALUE "FileVersion", GRIDTALK_VERSION
            VALUE "InternalName", "GridTalk-TS6-Relay"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "GridTalk-TS6-Relay.exe"
            VALUE "ProductName", "GridTalk TS6 Relay"
            VALUE "ProductVersion", GRIDTALK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
